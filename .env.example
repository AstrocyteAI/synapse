# Copy to .env — do not commit .env

# --- Astrocyte gateway ---
ASTROCYTE_TOKEN=dev-astrocyte-api-key

# --- Centrifugo ---
CENTRIFUGO_API_KEY=dev-centrifugo-api-key
CENTRIFUGO_TOKEN_SECRET=dev-centrifugo-token-secret

# --- Synapse auth ---
# dev mode: jwt_hs256 (shared secret) | production: jwt_oidc (JWKS/RS256)
SYNAPSE_AUTH_MODE=jwt_hs256
SYNAPSE_JWT_SECRET=dev-jwt-secret-change-in-production
SYNAPSE_JWT_AUDIENCE=synapse
# For jwt_oidc mode:
# SYNAPSE_AUTH_MODE=jwt_oidc
# SYNAPSE_JWT_JWKS_URL=https://your-oidc-provider/.well-known/jwks.json
# SYNAPSE_JWT_ISSUER=https://your-oidc-provider
# SYNAPSE_JWT_AUDIENCE=synapse

# --- LLM ---
OPENAI_API_KEY=
# Optional when you configure Anthropic/Gemini members:
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# AISIX gateway (optional — omit to call each provider directly). Model names
# are then AISIX model aliases. LITELLM_API_BASE is no longer supported and
# stops the backend from starting.
# LLM_GATEWAY_BASE_URL=http://localhost:4000/v1
# LLM_GATEWAY_API_KEY=gw-your-aisix-caller-key
# Optional local council defaults. docker-compose.yml defaults to OpenAI-only
# so the Flutter "New council" path works with just OPENAI_API_KEY.
# DEFAULT_MEMBERS=[{"model_id":"openai/gpt-4o-mini","name":"OpenAI","role":"General reasoning"}]
# DEFAULT_CHAIRMAN={"model_id":"openai/gpt-4o-mini","name":"OpenAI Chair","role":"Synthesize the council response"}

# --- EE license (optional) ---
# SYNAPSE_LICENSE_KEY=
